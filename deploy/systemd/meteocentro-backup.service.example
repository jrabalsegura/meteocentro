[Unit]
Description=Meteocentro daily PostgreSQL backup
After=meteocentro-db.service

[Service]
Type=oneshot
UMask=0077
# Substitute absolute paths. Use the script saved with the active release.
ExecStart=/usr/bin/python3 @STATE@/current/ops.py daily-backup --state @STATE@ --backups @BACKUPS@
TimeoutStartSec=7200
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

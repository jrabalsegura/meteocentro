FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv
FROM docker.io/library/python:3.13.18-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f AS build
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app/backend
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy UV_HTTP_TIMEOUT=300 UV_CONCURRENT_DOWNLOADS=2
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --no-install-project

FROM docker.io/library/python:3.13.18-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f
WORKDIR /app/backend
ENV PATH="/app/backend/.venv/bin:${PATH}" \
    PROVINCES_PATH=/app/config/provinces-full.geojson.gz \
    PYTHONPATH=/app/backend/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=build /app/backend/.venv ./.venv
COPY backend/src ./src
COPY backend/alembic.ini ./
COPY backend/alembic ./alembic
COPY config/provinces-full.geojson.gz /app/config/provinces-full.geojson.gz
USER 10001:10001
CMD ["python", "-m", "meteocentro.start", "api"]

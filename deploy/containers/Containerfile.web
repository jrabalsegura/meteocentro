FROM docker.io/library/node:24.22.2-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85 AS build
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
COPY config/provinces.geojson /app/config/provinces.geojson
RUN npm run build

FROM docker.io/library/nginx:1.31.8-alpine@sha256:785835ea65db4bba6f021acc0f3be91b0fef76a53fe41f8588c6698d2aed0606
COPY deploy/nginx/container.conf /etc/nginx/nginx.conf
COPY --chmod=755 deploy/containers/web-entrypoint.sh /usr/local/bin/web-entrypoint
COPY --from=build /app/frontend/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/web-entrypoint"]
CMD ["-g", "daemon off;"]

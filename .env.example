# Solo desarrollo local. Copiar a .env y cambiar antes de arrancar Compose.
POSTGRES_PASSWORD=replace_with_a_local_only_password
# Solo el servicio worker recibe esta clave. Nunca VITE_ ni configuración del navegador.
# AEMET_API_KEY=
AEMET_POLL_SECONDS=900
AEMET_DAILY_HTTP_BUDGET=400
AEMET_CURRENT_RESERVE=220
AEMET_MINUTE_HTTP_BUDGET=20
AEMET_CONCURRENCY=1

# Meteoclimatic: activación explícita según el uso y la licencia (ver OPERACION_FASE_3.md).
AEMET_ENABLED=true
METEOCLIMATIC_ENABLED=false
# Licencia publicada para uso local no comercial; no implica permiso especial para otros usos.
# METEOCLIMATIC_TERMS_REFERENCE=
METEOCLIMATIC_POLL_SECONDS=900
METEOCLIMATIC_DAILY_HTTP_BUDGET=300
METEOCLIMATIC_CURRENT_RESERVE=110
METEOCLIMATIC_MINUTE_HTTP_BUDGET=20

# Fase 5: límites locales, sin purga automática.
HISTORY_DAILY_HTTP_BUDGET=20
HISTORY_COVERAGE_THRESHOLD=0.9
DETAIL_RETENTION_MONTHS=24

# Rendered by ops.py prepare; install ONLY this new vhost after checking the host.
# Existing certificates are parameters; this file does not obtain certificates.
server {
    listen 80;
    server_name @DOMAIN@;
    location /.well-known/acme-challenge/ { root @ACME_ROOT@; }
    location / { return 301 https://@DOMAIN@$request_uri; }
}
server {
    listen 443 ssl;
    server_name @DOMAIN@;
    ssl_certificate @TLS_CERT@;
    ssl_certificate_key @TLS_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    # Avoid logging station filters, CSRF tokens or credentials.
    access_log off;
    error_log /var/log/nginx/meteocentro-error.log warn;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    location / {
        proxy_pass http://127.0.0.1:@PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_cache off;
    }
}

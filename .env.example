# Solo desarrollo local. Copiar a .env y cambiar antes de arrancar Compose.
POSTGRES_PASSWORD=replace_with_a_local_only_password
# Solo el servicio worker recibe esta clave. Nunca VITE_ ni configuración del navegador.
# AEMET_API_KEY=
AEMET_POLL_SECONDS=900
AEMET_DAILY_HTTP_BUDGET=400
AEMET_CURRENT_RESERVE=220
AEMET_MINUTE_HTTP_BUDGET=20
AEMET_CONCURRENCY=1

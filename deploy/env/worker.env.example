# Both networks remain enabled for private non-commercial use.
AEMET_ENABLED=true
AEMET_API_KEY=
AEMET_POLL_SECONDS=900
AEMET_DAILY_HTTP_BUDGET=400
AEMET_CURRENT_RESERVE=220
AEMET_MINUTE_HTTP_BUDGET=20
AEMET_CONCURRENCY=1
# Predicción municipal (Madrid y Huétor Santillán): 4 llamadas cada 3 horas dentro de la cuota AEMET.
AEMET_FORECAST_ENABLED=true
AEMET_FORECAST_SECONDS=10800
# Meteogramas GFS/ECMWF de Open-Meteo: sin clave, uso no comercial con atribución.
OPEN_METEO_ENABLED=true
OPEN_METEO_FORECAST_SECONDS=3600
METEOCLIMATIC_ENABLED=true
METEOCLIMATIC_TERMS_REFERENCE=https://www.meteoclimatic.net/index/wp/legal_es.html ; CC BY-NC-ND 3.0 ; uso privado no comercial
METEOCLIMATIC_POLL_SECONDS=900
METEOCLIMATIC_DAILY_HTTP_BUDGET=300
METEOCLIMATIC_CURRENT_RESERVE=110
METEOCLIMATIC_MINUTE_HTTP_BUDGET=20
HISTORY_DAILY_HTTP_BUDGET=20
DETAIL_RETENTION_MONTHS=24
